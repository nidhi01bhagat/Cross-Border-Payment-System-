# Backend Environment Variables (.env)

# Server
PORT=3000
NODE_ENV=development

# Helius (Solana RPC)
HELIUS_API_KEY=your_helius_api_key_here

# Dodo Payments
DODO_API_KEY=your_dodo_api_key_here
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here

# Solana (only for demo - NEVER store real keys in .env)
SOLANA_PRIVATE_KEY=[1,2,3,4,...]  # Only for testing!

# Frontend Environment Variables (.env.local)
REACT_APP_HELIUS_API_KEY=your_helius_api_key_here
